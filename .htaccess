# Anglish — configuración de Apache para XAMPP
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Las rutas limpias (/Anglish/login) se envían al front controller.
    # Los archivos y carpetas existentes (public/, index.php) se respetan.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

# Nunca servir documentación, SQL, logs ni configuraciones.
<FilesMatch "\.(sql|log|md|env|ini|bak|old)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
